{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EmpateLive Launcher",
  "version": "0.1.0",
  "identifier": "com.empatelive.launcher",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "bash scripts/preparar_recursos.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "EmpateLive — Panel de control",
        "width": 640,
        "height": 720,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../docker-compose.prod.yml": "stack/docker-compose.prod.yml",
      "../../.env.prod.example": "stack/.env.prod.example",
      "../../cloudflared/config.yml": "stack/cloudflared/config.yml",
      "../resources-build/api": "stack/api",
      "../resources-build/panel/dist": "stack/panel/dist",
      "../resources-build/web-publica/dist": "stack/web-publica/dist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
