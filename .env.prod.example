# Plantilla para docker-compose.prod.yml. El launcher genera un .env real con
# valores aleatorios en el primer arranque (nunca commitear el .env real).
POSTGRES_PASSWORD=cambia-esto-por-un-valor-aleatorio
SECRET_KEY=cambia-esto-por-un-valor-aleatorio
BACKUP_PASSPHRASE=cambia-esto-por-un-valor-aleatorio
BACKUP_DIR_SECUNDARIO=
ADMIN_BOOTSTRAP_EMAIL=admin@localhost

# El túnel (docker compose --profile tunel up) no usa variables de entorno: su
# configuración vive en cloudflared/config.yml (tunnel ID, hostname, credentials
# file) — ver docs/guia_tunel_cloudflare.md.
